pipeline {

    agent any

    parameters {
        choice(
                name: 'ACTION',
                choices: ['DEPLOY', 'DESTROY'],
                description: 'Choose DEPLOY to deploy the application or DESTROY to remove the EKS infrastructure and ECR repository.'
        )
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '911291530745'

        ECR_REPOSITORY = 'springboot-app'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        IMAGE_NAME = "${ECR_REGISTRY}/${ECR_REPOSITORY}"

        TERRAFORM_DIR = 'deployment\\terraform'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([
                            usernamePassword(
                                    credentialsId: 'aws-ecr',
                                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                            )
                    ]) {
                        bat 'terraform init'
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([
                            usernamePassword(
                                    credentialsId: 'aws-ecr',
                                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                            )
                    ]) {
                        bat 'terraform apply -auto-approve'
                    }
                }
            }
        }

        stage('Test') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {
                bat 'mvnw.cmd clean test'
            }
        }

        stage('Build JAR') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {
                bat 'mvnw.cmd clean package -DskipTests'
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {
                bat 'docker build -t %IMAGE_NAME%:%BUILD_NUMBER% .'
            }
        }

        stage('Login to ECR') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {

                withCredentials([
                        usernamePassword(
                                credentialsId: 'aws-ecr',
                                usernameVariable: 'AWS_ACCESS_KEY_ID',
                                passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                ]) {

                    bat '''
                        aws sts get-caller-identity

                        aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %ECR_REGISTRY%
                    '''
                }
            }
        }

        stage('Push Image') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {
                bat 'docker push %IMAGE_NAME%:%BUILD_NUMBER%'
            }
        }

        stage('Get EC2 IP') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                            usernamePassword(
                                    credentialsId: 'aws-ecr',
                                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                            )
                    ]) {

                        bat '''
                    terraform output -raw ec2_public_ip > ec2_ip.txt
                '''
                    }
                }

                script {
                    env.EC2_PUBLIC_IP = readFile(
                            "${TERRAFORM_DIR}\\ec2_ip.txt"
                    ).trim()

                    echo "EC2 IP: ${env.EC2_PUBLIC_IP}"
                }
            }
        }

        stage('Deploy to EC2') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                        usernamePassword(
                                credentialsId: 'aws-ecr',
                                usernameVariable: 'AWS_ACCESS_KEY_ID',
                                passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        ),
                        sshUserPrivateKey(
                                credentialsId: 'ec2-ssh-key',
                                keyFileVariable: 'SSH_KEY',
                                usernameVariable: 'SSH_USER'
                        )
                ]) {

                    bat """
                ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=no %SSH_USER%@${EC2_PUBLIC_IP} "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
            """

                    bat """
                ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=no %SSH_USER%@${EC2_PUBLIC_IP} "docker pull ${IMAGE_NAME}:${BUILD_NUMBER}"
            """

                    bat """
                ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=no %SSH_USER%@${EC2_PUBLIC_IP} "docker stop springboot-app"
            """

                    bat """
                ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=no %SSH_USER%@${EC2_PUBLIC_IP} "docker rm springboot-app"
            """

                    bat """
                ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=no %SSH_USER%@${EC2_PUBLIC_IP} "docker run -d --name springboot-app -p 9191:9191 ${IMAGE_NAME}:${BUILD_NUMBER}"
            """
                }
            }
        }

        stage('Verify Application') {
            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }
            steps {

                bat """
                    curl http://${EC2_PUBLIC_IP}:9191
                """
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([
                            usernamePassword(
                                    credentialsId: 'aws-ecr',
                                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                            )
                    ]) {
                        bat 'terraform destroy -auto-approve'
                    }
                }
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo 'Spring Boot deployment successful!'
            echo '======================================'
        }

        failure {
            echo 'Spring Boot deployment failed!'
        }
    }
}